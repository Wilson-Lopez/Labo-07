<Window x:Class="Biblioteca.WPF.wPrestamo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Préstamo" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Datos del préstamo -->
        <GroupBox Grid.Row="0" Header="Datos del préstamo" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Socio:" 
                           VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbSocio" Margin="5"
                          DisplayMemberPath="Nombre" SelectedValuePath="SocioId"
                          SelectionChanged="CmbSocio_SelectionChanged"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Fecha límite:" 
                           VerticalAlignment="Center" Margin="10,5,0,5"/>
                <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dpFechaLimite" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pendientes actuales:" 
                           VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblPendientes" Margin="5"
                           FontWeight="Bold" Foreground="DarkBlue"
                           VerticalAlignment="Center" Text="0"/>
            </Grid>
        </GroupBox>

        <!-- Agregar libros -->
        <GroupBox Grid.Row="1" Header="Agregar libro" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Libro:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Column="1" x:Name="cmbLibro" Margin="0,0,8,0"
                           DisplayMemberPath="Titulo" SelectedValuePath="LibroId"/>
                <Button    Grid.Column="2" Content="Agregar" Width="120" Click="BtnAgregarLibro_Click"/>
            </Grid>
        </GroupBox>

        <!-- Lista de libros a prestar -->
        <DataGrid Grid.Row="2" x:Name="dgDetalles" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Libro"  Binding="{Binding Titulo}"     Width="*"/>
                <DataGridTextColumn Header="Autor"  Binding="{Binding NombreAutor}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Quitar libro seleccionado" Width="180" Margin="5,0" Click="BtnQuitar_Click"/>
            <Button Content="Registrar préstamo" Width="180" Margin="5,0"
                    FontWeight="Bold" Background="#4CAF50" Foreground="White" Click="BtnRegistrar_Click"/>
            <Button Content="Cerrar" Width="100" Margin="5,0" Click="BtnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>