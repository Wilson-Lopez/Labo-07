<Window x:Class="Biblioteca.WPF.wLibros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento de Libros" Height="620" Width="950"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Buscar por título o autor:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="txtFiltro" Width="320" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
            <Button Content="Buscar" Width="100" Click="BtnBuscar_Click"/>
            <Button Content="Ver todos" Width="100" Margin="8,0,0,0" Click="BtnTodos_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" x:Name="dgLibros" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgLibros_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding LibroId}"     Width="50"/>
                <DataGridTextColumn Header="Título"      Binding="{Binding Titulo}"      Width="*"/>
                <DataGridTextColumn Header="ISBN"        Binding="{Binding ISBN}"        Width="150"/>
                <DataGridTextColumn Header="Autor"       Binding="{Binding NombreAutor}" Width="200"/>
                <DataGridTextColumn Header="Ejemplares"  Binding="{Binding Ejemplares}"  Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Formulario -->
        <GroupBox Grid.Row="2" Header="Datos del libro" Margin="0,10,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Título:"     VerticalAlignment="Center" Margin="0,5"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtTitulo" Margin="5"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="ISBN:"       VerticalAlignment="Center" Margin="10,5,0,5"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="txtISBN"   Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Autor:"      VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cmbAutor"
                           DisplayMemberPath="Nombre" SelectedValuePath="AutorId" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Ejemplares:" VerticalAlignment="Center" Margin="10,5,0,5"/>
                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="txtEjemplares" Margin="5"/>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Nuevo"    Width="100" Margin="5,0" Click="BtnNuevo_Click"/>
                    <Button Content="Guardar"  Width="100" Margin="5,0" Click="BtnGuardar_Click"/>
                    <Button Content="Eliminar" Width="100" Margin="5,0" Click="BtnEliminar_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>