<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca - Menú Principal" Height="420" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sistema de Biblioteca" 
                   FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Button Content="Mantenimiento de Libros"    Height="45" Margin="0,5" FontSize="14" Click="BtnLibros_Click"/>
            <Button Content="Mantenimiento de Socios"    Height="45" Margin="0,5" FontSize="14" Click="BtnSocios_Click"/>
            <Button Content="Registrar Préstamo"         Height="45" Margin="0,5" FontSize="14" Click="BtnPrestamo_Click"/>
            <Button Content="Registrar Devolución"       Height="45" Margin="0,5" FontSize="14" Click="BtnDevolucion_Click"/>
            <Button Content="Reporte por Fechas"         Height="45" Margin="0,5" FontSize="14" Click="BtnReporte_Click"/>
        </StackPanel>
    </Grid>
</Window>