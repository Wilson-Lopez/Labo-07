<Window x:Class="Biblioteca.WPF.wDevolucion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Devolución" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Selección de socio -->
        <GroupBox Grid.Row="0" Header="Socio" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Socio:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Column="1" x:Name="cmbSocio" 
                           DisplayMemberPath="Nombre" SelectedValuePath="SocioId"
                           SelectionChanged="CmbSocio_SelectionChanged"/>
            </Grid>
        </GroupBox>

        <!-- Selección de préstamo -->
        <GroupBox Grid.Row="1" Header="Préstamo" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Préstamo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Column="1" x:Name="cmbPrestamo"
                           SelectionChanged="CmbPrestamo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="Préstamo #"/>
                                <Run Text="{Binding PrestamoId}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}"/>
                                <Run Text=" — Límite: "/>
                                <Run Text="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"/>
                                <Run Text=" — Estado: "/>
                                <Run Text="{Binding Estado}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Libros pendientes -->
        <DataGrid Grid.Row="2" x:Name="dgPendientes" Margin="0,10,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DgPendientes_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Libro"        Binding="{Binding TituloLibro}" Width="*"/>
                <DataGridTextColumn Header="F. Límite"    Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Multa y botones -->
        <GroupBox Grid.Row="3" Header="Devolución" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Multa calculada:" VerticalAlignment="Center"
                           FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="lblMulta" FontSize="18" FontWeight="Bold"
                           Foreground="DarkRed" VerticalAlignment="Center"
                           Text="S/ 0.00"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Registrar devolución" Width="180" Margin="5,0"
                            FontWeight="Bold" Background="#4CAF50" Foreground="White"
                            Click="BtnRegistrarDevolucion_Click"/>
                    <Button Content="Cerrar" Width="100" Margin="5,0" Click="BtnCerrar_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>